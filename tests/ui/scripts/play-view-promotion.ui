# Play view: the promotion picker opens over the square on the card (tests/ui/positions/promotion.5dp: White's pawn on e7, clicking e8), N picks the
# knight, and the new piece flies / lands on the card. "Start turns in Play view" is on, so the position opens in the Play view.
startplayview on
position ../positions/promotion.5dp
wait 60
camexpect playview 1
clicksq 0 4 e7
wait 30
clicksq 0 4 e8       # the promotion square: the picker opens beside it
wait 40
capture play-view-promotion-picker
key N
wait 60
capture play-view-promotion-knight
